{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["sop_1_matching"],
  "properties": {
    "sop_1_matching": {
      "type": "object",
      "required": [
        "overall_score",
        "radar_dimensions",
        "key_strengths",
        "skill_gaps",
        "sprint_priorities"
      ],
      "properties": {
        "overall_score": { "type": "number", "minimum": 0, "maximum": 100 },
        "radar_dimensions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["dimension", "score", "comment"],
            "properties": {
              "dimension": { "type": "string" },
              "score": { "type": "number" },
              "comment": { "type": "string" }
            }
          }
        },
        "key_strengths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "skill_gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["skill", "level", "suggestion"],
            "properties": {
              "skill": { "type": "string" },
              "level": { "type": "string" },
              "suggestion": { "type": "string" }
            }
          }
        },
        "sprint_priorities": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
